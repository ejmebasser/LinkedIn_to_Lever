{
  "manifest_version": 3,
  "name": "Recruiter to Lever",
  "version": "1.0.0",
  "description": "Capture recruiting candidates and populate Lever.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://*.lever.co/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "linkedin.js"
      ]
    },
    {
      "matches": [
        "https://*.lever.co/*"
      ],
      "js": [
        "lever.js"
      ]
    }
  ]
}